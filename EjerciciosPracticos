# 3. Módulo par e impar

print("Identificador de números pares e impares")

#Pedimos un número entero al usuario
numero = int(input(">Ingrese un número entero: "))

#Si el residuo al dividir entre 2 es cero, es par
if numero % 2 == 0:
     print(">El número",numero, "es par" )
     
# Si tiene residuo, es impar
else:
      print(">El número",numero, "es impar" )
# 4. Comparación Lógica

print("Comparación de edad")

# Pedimos las dos edades al usuario
edad1 = int(input(">Ingrese un número de edad: "))
edad2 = int(input(">Ingrese otro número de edad: "))

# Comprobamos si ambas edades son iguales
igualdad = (edad1 == edad2)
print(">Son iguales ambas edad?: ", igualdad)

# Verificamos si la primera edad es mayor que la segunda
mayor = edad1 > edad2
print(">La primer edad es mayor qué la segunda?: ", mayor)

# Verificamos si ambas edades son mayores que 18
mayor18 = (edad1 > 18) and (edad2 > 18)
print(">Ambas edades son mayores qué 18?: ", mayor18)

# 6. Constantes físicas

print("Encontrar el área de un círculo")

# Ingresamos el radio del círculo 
radio = float(input(">Define el Radio(r): "))

# Definimos la constante PI
Pi = 3.1416
print(">(π)=",Pi)

# Calculamos el área aplicando la fórmula
Área = Pi * radio ** 2

# Mostramos la fórmula y el resultado final
print(">Formula a usarse: (A = π x r²)")

print (">El área total del círculo es :", Área,"cm")
